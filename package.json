{
  "name": "rotacloud",
  "version": "2.4.0",
  "description": "The RotaCloud SDK for the RotaCloud API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "version:bump": "npm --no-git-tag-version version patch",
    "watch": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "check:types": "node scripts/check-types.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:types && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotacloud/rotacloud-node.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rotacloud/rotacloud-node/issues"
  },
  "homepage": "https://github.com/rotacloud/rotacloud-node#readme",
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@rotacloud/types": "0.1.2",
    "@types/node": "^18.19.64",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.3.0",
    "eslint": "^8.46.0",
    "eslint-config-airbnb": "^19.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "~3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "axios-retry": "^4.5.0"
  },
  "types": "./dist/main.d.ts"
}
